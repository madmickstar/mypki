# mypki configuration — copy to `.env` and edit, or export the same names in the shell.
#
# Every variable carries the `MYPKI_` prefix and there are NO unprefixed aliases, on purpose: a bare `DATA_DIR`, `HOST` or
# `PORT` sitting in the same environment as another service is either silently adopted by mypki or silently ignored by it,
# and both readings are wrong. A prefix makes the ownership of each knob explicit (page-map §11).
#
# Every numeric knob below has a `ge=`/`le=` bound in src/mypki/config.py, so an impossible value is a pydantic
# ValidationError at process start rather than a surprise mid-signing. That is deliberate: "the CA refuses to start" is a
# better failure than "the CA issued a 10-year certificate you cannot revoke".
#
# Precedence for the data dir: `mypki serve --data-dir` > MYPKI_DATA_DIR > OS default.

# ------------------------------------------------------------------------------ serving
# Bind address. Loopback by default because there are no logins here: exposure is controlled by binding and TLS, not by
# accounts (page-map §0). Any non-loopback value makes `mypki serve` print a LAN-exposure warning — anyone who can reach
# the port can then ask this CA to sign certificates.
MYPKI_HOST=127.0.0.1

# Listen port (1-65535). 8443 is conventional for an internal HTTPS service; nothing else on this host may already hold it.
MYPKI_PORT=8443

# TLS for uvicorn itself. Set BOTH or neither: a cert without a key (or the reverse) makes uvicorn fail at bind time with an
# error that reads like a file-permission problem, and `tls_enabled` — which is what makes session cookies `Secure` — is
# defined as "both are set" so the banner and the cookie cannot disagree. These are *server* keys; mypki never writes or
# reads <data>/ca/ca_key.pem on their behalf. Usually simpler: leave these unset, keep MYPKI_HOST on loopback, and let
# nginx/Caddy/IIS terminate TLS and forward to 127.0.0.1. Cookies become Secure only when BOTH knobs here are set, so a
# proxy-terminated setup marks them Secure at the proxy, not here.
#
# SPELL THESE PATHS WITH FORWARD SLASHES, OR SINGLE BACKSLASHES. A dotenv line is not a PowerShell or Python string:
#   MYPKI_SSL_CERTFILE=C:/root_apps/python_projects/mypki-data/www/server.crt     <- preferred on Windows
#   MYPKI_SSL_CERTFILE=C:\root_apps\python_projects\mypki-data\www\server.crt    <- also fine: ONE backslash each
# Doubling them (C:\\root_apps\\...) is the mistake that broke a real install: dotenv hands the doubled text to pydantic
# verbatim, so mypki looks for a path whose separators are literally doubled and finds nothing. As of 0.4.0 `mypki serve`
# says exactly that before it binds — exit 1 naming MYPKI_SSL_CERTFILE (or MYPKI_SSL_KEYFILE) and the path — instead of
# the old misleading 'cannot bind 0.0.0.0:8443: [Errno 2] No such file or directory'. Quoting the value is worse, not
# better: inside double quotes dotenv treats \ as an escape character.
#MYPKI_SSL_CERTFILE=
#MYPKI_SSL_KEYFILE=

# Absolute base URL the app is reached at, used only for messages that should be copy-pasteable. Unset means relative links.
#MYPKI_PUBLIC_BASE_URL=https://ca.internal.example

# The base this CA bakes into every certificate it issues from 0.7.0 on: CRLDistributionPoints is this value plus
# /revoke.crl, and AuthorityInfoAccess is this value plus /ocsp. It must start with http:// or https:// — a bare host name
# is refused at startup, because the text is copied into certificates that outlive the change and cannot be edited
# afterwards. Changing it changes only certificates issued after the change.
#
# The value has to RESOLVE WHERE THE CLIENTS ARE. Advertising http://mypki.my.lab while binding 127.0.0.1 publishes URLs
# no client can reach without a DNS entry, a hosts line or a proxy; `mypki serve` prints both facts at startup for exactly
# that reason. The CRL itself is served by this app at <data>/crl/revoke.crl and GET /revoke.crl (page-map §14).
MYPKI_CRL_BASE_URL=http://mypki.my.lab

# ------------------------------------------------------------------------------ storage
# Where ca/, instance/ and issued.db live. Unset means the OS default: `$XDG_DATA_HOME/mypki`, else `~/.local/share/mypki`
# on Linux/macOS; `%LOCALAPPDATA%\mypki` on Windows. The cost of setting it is a placement decision — putting it inside a
# web-served directory exposes nothing today and everything after a future refactor.
#MYPKI_DATA_DIR=/var/lib/mypki

# Config dir (`$XDG_CONFIG_HOME/mypki`, else `~/.config/mypki`; `%APPDATA%\mypki` on Windows). mypki reads no config file
# from it yet; it is resolved so the two directories cannot collapse into one and a future feature cannot silently make
# them the same place.
#MYPKI_CONFIG_DIR=

# ------------------------------------------------------------------------------ CA defaults
# Default `--common-name` for `mypki init-ca`. Changing it later means re-issuing the CA and re-installing it on every
# client that trusted the old name — this is the knob with the most expensive "just rename it" story.
MYPKI_CA_CN=mypki Root CA

# Default `--days` for the root CA (1-3650). A root is trusted by explicit installation rather than by policy, so it may
# outlive a leaf; 10 years costs an early retirement if the key is ever lost.
MYPKI_CA_DEFAULT_DAYS=3650

# ------------------------------------------------------------------------------ issue limits
# Default `validity_days` on the sign page (1-1461). This number is also the default exposure window for a mistake:
# revocations are recorded on this host, but no CRL or OCSP is published, so whatever you sign by default stays trusted by
# clients that long.
MYPKI_VALIDITY_DEFAULT_DAYS=365

# Highest `validity_days` the sign page accepts (1-1461 = 4 years). Over-max requests are refused naming this limit, never
# quietly clamped: an operator who asked for 2000 and silently received 1461 believes they hold a certificate valid until a
# date nobody wrote down. Raised from 825 in 0.2.0 because `/issued` now RECORDS revocations, so a long-lived leaf is a
# documented decision rather than an unbounded bet — but recording one is not publishing one, so this limit is still the main
# bound on a mistake and short-lived certificates are still the right default.
#
# MEASURED on cryptography 50.0.2: the builder accepts 825, 1000, 1188, 1461 and even 3650 days without complaint, so nothing
# in the library enforces any of these numbers. The widely cited 398/825-day windows are rules applied to certificates from
# publicly-trusted CAs and were never measurable on any host running mypki. If a client of yours refuses a long-lived leaf,
# set this back to 825 — that is what the knob exists for.
MYPKI_VALIDITY_MAX_DAYS=1461

# Cap on SAN entries per CSR (1-1000). Each SAN is a name this CA is being asked to vouch for; the cap bounds one request's
# blast radius rather than the size of a page. Enforced on the generate form AND on the sign page's editable SAN box.
MYPKI_MAX_SANS=100

# Cap on the pasted CSR textarea (1024-1000000). A 4096-bit RSA CSR is ~2.5 KB, so 32 000 covers every accepted key size
# with room for a large SAN list. The limit exists so oversized input is rejected through mypki's own error page naming this
# value rather than through starlette's bare JSON `Field exceeded maximum size of 1024KB.` (MEASURED).
MYPKI_MAX_CSR_CHARS=32000

# Session cookie lifetime in seconds (60-86400). Also bounds how long a half-finished two-step signing survives an
# interrupted browser: past this, the pending CSR is gone and the paste has to start again. (The confirm page's `?pending=`
# action carries the staged request independently of the cookie, which is what makes a rejected edit recoverable.)
MYPKI_SESSION_MAX_AGE=3600

# ------------------------------------------------------------------------------ CSR subject prefills (0.2.0)
# What the Generate-CSR page starts filled in. These exist because "Lab / IT / AU" is somebody else's organisation: each host
# states its own defaults instead of everybody editing a template. Set them once and signing for your own organisation means
# typing a common name and nothing else.
#
# They are prefills, not requirements: an EMPTY value leaves that field blank on the page, and a blank box is how "no such
# attribute" is supposed to look. Each one passes the same validators the form applies (`validate_printable_field`,
# `validate_country`, `validate_email`), checked at process start rather than mid-signing — an impossible default is a startup
# error, not a surprise at the moment of signing.
MYPKI_DEFAULT_ORGANIZATION=Lab
MYPKI_DEFAULT_ORGANIZATIONAL_UNIT=IT
# Exactly two letters when set.
MYPKI_DEFAULT_COUNTRY=AU
MYPKI_DEFAULT_STATE=Victoria
MYPKI_DEFAULT_LOCALITY=Melbourne
# Prefills the email SUBJECT attribute, not a SAN: mypki never copies a CSR's other extensions, and an email in the subject is
# not a name a client matches against.
MYPKI_DEFAULT_EMAIL=it@mypki.lab

# ------------------------------------------------------------------------------ logging
# CRITICAL|ERROR|WARNING|INFO|DEBUG. An unknown name is a startup error rather than a silent fallback — a log level nobody
# asked for is a log level nobody can trust the output of. DEBUG rotates faster, which shortens how far back you can look.
MYPKI_LOG_LEVEL=INFO

# Rotating log file. A RELATIVE path resolves against the working directory, so `logs/mypki.log` lands under wherever the
# process was started from — and the resolved absolute path is the first line written to the file, which is what makes
# "where did it actually land?" answerable from the process rather than from reading this file. An EMPTY value means
# console-only (no file handler at all).
MYPKI_LOG_FILE=logs/mypki.log

# Rotate once the log passes this many bytes (1024-1073741824). Default 10 MiB.
MYPKI_LOG_MAX_BYTES=10485760

# Rotated files kept besides the live one (0-100). Total disk use is bounded at MYPKI_LOG_MAX_BYTES * (count + 1) = 60 MiB
# with the two defaults. Rotation is PER-PROCESS, so run one worker per log file: two workers rotating the same file each
# count the bytes they wrote and not the bytes that exist.
MYPKI_LOG_BACKUP_COUNT=5

# Mirror logs to stderr as well as the file. Costs nothing locally; costs a supervisor duplicating every line when it already
# captures stdout.
MYPKI_LOG_TO_CONSOLE=true

# A filter on the `mypki` logger tree (and on root, because uvicorn's lines arrive there) drops any record containing
# PRIVATE KEY. There is no knob for it and that is the point: this project's failure mode is not too little in the log but
# too much, and an invariant you have to remember is an invariant that eventually isn't kept.

# ------------------------------------------------------------------------------ secrets
# Session signing key. Unset means mypki generates one into <data>/instance/secret_key (0600 on POSIX) and reuses it, so
# sessions survive a restart. Setting it explicitly is how sessions stay valid across hosts — and the cost is that the value
# is now readable by anyone who can read `.env`, so commit neither the file nor this line.
#MYPKI_SECRET_KEY=
